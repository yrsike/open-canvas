# Cloudflare Workers / OpenNext 本地开发用 secrets
# 复制本文件为 .dev.vars 并填写真实值（.dev.vars 已在 .gitignore 中，不会入库）
# 这些变量在生产环境通过 `wrangler secret put <KEY>` 注入

# 腾讯云 MPS (AI 换装)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# MiniMax (MiniMax 开放平台 API)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Cyberbara / OpenRouter / Replicate (BYOK 可选)
CYBERBARA_API_KEY=
OPENROUTER_API_KEY=
REPLICATE_API_TOKEN=

# 腾讯云 COS / S3 兼容存储 (生产推荐替代本地 public/uploads)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=